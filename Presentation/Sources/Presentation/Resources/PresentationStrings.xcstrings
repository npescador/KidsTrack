        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Password"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Contraseña"
          }
        }
      }
    },
    "login.form.password.placeholder": {
      "comment": "Placeholder for the password text field.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter your password"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce tu contraseña"
          }
        }
      }
    },
    "login.form.password.forgot": {
      "comment": "Action to trigger password recovery.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Forgot Password?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Olvidaste tu contraseña?"
          }
        }
      }
    },
    "login.form.password.show": {
      "comment": "Accessibility label for toggling password visibility.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show password"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar contraseña"
          }
        }
      }
    },
    "login.form.password.hide": {
      "comment": "Accessibility label for toggling password visibility off.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hide password"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocultar contraseña"
          }
        }
      }
    },
    "login.form.primary.cta": {
      "comment": "Primary CTA title for the login form submission.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Log In"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Iniciar sesión"
          }
        }
      }
    },
    "login.form.primary.cta.hint": {
      "comment": "Accessibility hint explaining what the login button does.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Attempts to authenticate with the provided credentials."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Intenta autenticarse con las credenciales proporcionadas."
          }
        }
      }
    },
    "login.divider.text": {
      "comment": "Text displayed between the login form and social logins.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OR"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "O"
          }
        }
      }
    },
    "login.social.google.title": {
      "comment": "Button title for Google social login.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue with Google"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuar con Google"
          }
        }
      }
    },
    "login.social.google.hint": {
      "comment": "Accessibility hint for the Google login button.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens Google sign-in to authenticate."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre el inicio de sesión de Google para autenticarte."
          }
        }
      }
    },
    "login.signup.prompt": {
      "comment": "Text shown before the Sign Up CTA on the login screen.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Don't have an account?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿No tienes una cuenta?"
          }
        }
      }
    },
    "login.signup.cta": {
      "comment": "Button title encouraging users to create an account.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign Up"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Regístrate"
