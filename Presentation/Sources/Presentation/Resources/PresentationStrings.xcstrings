    "welcome.feature.schedules.title": {
      "comment": "Feature card title referring to school and class schedules.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Schedules"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Horarios"
          }
