      "comment": "Supporting copy shown beneath the welcome headline.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your family's command center, simplified."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El centro de mando de tu familia, simplificado."
