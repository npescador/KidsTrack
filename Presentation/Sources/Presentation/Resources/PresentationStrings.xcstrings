  "strings": {
    "welcome.header.title": {
      "comment": "Main greeting shown on the welcome screen headline.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Welcome, Sarah!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00a1Bienvenida, Sarah!"
          }
        }
      }
    },
    "welcome.header.subtitle": {
      "comment": "Supporting copy shown beneath the welcome headline.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your family's command center, simplified."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El centro de mando de tu familia, simplificado."
          }
        }
      }
