    "welcome.header.title": {
      "comment": "Main greeting shown on the welcome screen headline.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Welcome, Sarah!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Bienvenida, Sarah!"
          }
        }
      }
    },
