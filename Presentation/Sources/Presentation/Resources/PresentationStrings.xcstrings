      "comment": "Feature card description for schedules.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Easily track school and class schedules in one place."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Controla f\u00e1cilmente los horarios escolares y de clases en un solo lugar."
          }
        }
