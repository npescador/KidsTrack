{
  "sourceLanguage": "en",
  "strings": {
    "welcome.header.title": {
      "comment": "Main greeting shown on the welcome screen headline.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Welcome, Sarah!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Bienvenida, Sarah!"
          }
        }
      }
    },
    "welcome.header.subtitle": {
      "comment": "Supporting copy shown beneath the welcome headline.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your family's command center, simplified."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El centro de mando de tu familia, simplificado."
          }
        }
      }
    },
    "welcome.hero.accessibility.label": {
      "comment": "Accessibility label describing the hero image on the welcome screen.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Family dashboard illustration"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilustración del panel familiar"
          }
        }
      }
    },
    "welcome.cta.title": {
      "comment": "Primary call-to-action button title on the welcome screen.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get Started"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comenzar"
          }
        }
      }
    },
    "welcome.cta.accessibility.label": {
      "comment": "Accessibility label announcing the primary call-to-action button.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Begin KidsTrack onboarding"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Iniciar la incorporación a KidsTrack"
          }
        }
      }
    },
    "welcome.cta.accessibility.hint": {
      "comment": "Accessibility hint describing what happens when activating the CTA.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Advances to the setup flow for your family."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Avanza al flujo de configuración para tu familia."
          }
        }
      }
    },
    "welcome.feature.schedules.title": {
      "comment": "Feature card title referring to school and class schedules.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Schedules"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Horarios"
          }
        }
      }
    },
    "welcome.feature.schedules.description": {
      "comment": "Feature card description for schedules.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Easily track school and class schedules in one place."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Controla fácilmente los horarios escolares y de clases en un solo lugar."
          }
        }
      }
    },
    "welcome.feature.activities.title": {
      "comment": "Feature card title covering extracurricular activities.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Activities"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actividades"
          }
        }
      }
    },
    "welcome.feature.activities.description": {
      "comment": "Feature card description for activities.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Never miss a practice or event for extracurriculars."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No te pierdas ningún entrenamiento ni evento extracurricular."
          }
        }
      }
    },
    "welcome.feature.expenses.title": {
      "comment": "Feature card title covering school-related expenses.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Expenses"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gastos"
          }
        }
      }
    },
    "welcome.feature.expenses.description": {
      "comment": "Feature card description for expenses.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep an eye on activity fees and school-related spending."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén a la vista las cuotas de actividades y los gastos escolares."
          }
        }
      }
    },
    "login.header.title": {
      "comment": "Primary headline shown on the login screen.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Welcome back!"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Te damos la bienvenida de nuevo!"
          }
        }
      }
    },
    "login.header.subtitle": {
      "comment": "Supporting text beneath the login headline.",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Log in to manage your family's schedule."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión para gestionar la agenda de tu familia."
          }
        }
      }
    },
    "login.form.email.label": {
      "comment": "Label for the email text field on the login screen.",
